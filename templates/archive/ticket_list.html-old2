{% extends 'base.html' %}
{% load static %}
{% block sub_header %}
  {% include 'sub_header.html' %}
{% endblock %}

{% block content %}
<div class="container-ld px-5 py-4">
  <h4 class="fw-bold text-dark ps-2">SIB Query List</h4>

  <table class="table table-bordered table-hover mt-3" style="background: #fff;">
    <thead class="table-light">
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Status</th>
        <th>Created By</th>
        
        <th>Created At</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for ticket in tickets %}
      <tr>
        <td>{{ ticket.id }}</td>
        <td>{{ ticket.title }}</td>
        <td>{{ ticket.status }}</td>
        <td>{{ ticket.created_by.username }}</td>
        <td>{{ ticket.created_at|date:"d M Y H:i" }}</td>
        <td>
          <a href="{% url 'tickets:ticket_detail' ticket.id %}" class="btn btn-sm btn-primary">View</a>
        </td>
      </tr>
      {% empty %}
      <tr><td colspan="6" class="text-center">No SIB Query found.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
